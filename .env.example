# ==============================================================================
# SMART PARKING MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' or set these environment variables on your server.
# NEVER commit the actual '.env' file or production credentials to version control.

# Application Configuration
APP_ENV=development
APP_DEBUG=true
APP_BASE_URL=http://localhost:8080/smart-parking

# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_parking_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_POOL_MIN_IDLE=2
DB_POOL_MAX_ACTIVE=10

# Email Notifications (SMTP - Jakarta Mail)
# In development mode without SMTP credentials, notifications are recorded as SIMULATED.
MAIL_ENABLED=false
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_app_password_here
MAIL_FROM=no-reply@smartparking.local
MAIL_FROM_NAME=Smart Parking System

# SMS Notifications (Twilio REST API)
# In development mode without Twilio credentials, notifications are recorded as SIMULATED.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# Expiry Background Scheduler Configuration
SCHEDULER_ENABLED=true
SCHEDULER_INITIAL_DELAY_SECONDS=15
SCHEDULER_INTERVAL_SECONDS=60
NOTIFICATION_MAX_RETRIES=3
